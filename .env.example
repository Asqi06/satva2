MONGODB_URI=mongodb://127.0.0.1:27017/satvastones

AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=

# Transactional sender. Default is Resend's test sender (dev only);
# production needs a verified domain (see DEPLOYMENT.md).
EMAIL_FROM=

# One-time owner bootstrap (unset after use). See AUTH.md.
ADMIN_SEED_EMAIL=

# Test-only E2E seed gate (never set in production). See src/app/api/test/seed/route.ts.
E2E_SEED_SECRET=

# Vercel Cron bearer for /api/cron/* (generate with `openssl rand -hex 32`).
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NEXT_PUBLIC_GA_ID=
