RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative to the keypair above: an unsigned upload preset name
# (Cloudinary Console → Settings → Upload → Upload presets, Signing Mode: Unsigned).
# Uploads still run through our API (auth + validation server-side); no secret needed.
# Either the keypair OR the preset must be set, or uploads return 503.
CLOUDINARY_UPLOAD_PRESET=

RESEND_API_KEY=

# Transactional sender. Default is Resend's test sender (dev only);
# production needs a verified domain (see DEPLOYMENT.md).
EMAIL_FROM=

# One-time owner bootstrap (unset after use). See AUTH.md.
ADMIN_SEED_EMAIL=

# Test-only E2E seed gate (never set in production). See src/app/api/test/seed/route.ts.
E2E_SEED_SECRET=

# Vercel Cron bearer for /api/cron/* (generate with `openssl rand -hex 32`).
CRON_SECRET=

# TypeSafe (Jev) key for AI judgments (SEO readiness CLI). Server-only, never prefixed.
# Without it, `npm run seo:readiness` prints deterministic checks only.
TYPESAFE_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NEXT_PUBLIC_GA_ID=
